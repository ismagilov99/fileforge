{
  "name": "fileforge",
  "private": true,
  "version": "5.5.2",
  "description": "Local-first browser file utilities with bounded processing, defensive validation and no file-upload backend.",
  "type": "module",
  "engines": {
    "node": ">=24.22.3",
    "npm": ">=11.19.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome check --linter-enabled=false --assist-enabled=false .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "build": "npm run typecheck && vite build && node scripts/check-production-csp.mjs",
    "verify": "npm run manifest:check && npm run check && npm run build && npm run test:e2e && npm run audit",
    "audit": "npm audit --audit-level=low",
    "sbom": "node scripts/generate-sbom.mjs",
    "manifest:write": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "dompurify": "3.5.0",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "npm@11.19.1"
}
